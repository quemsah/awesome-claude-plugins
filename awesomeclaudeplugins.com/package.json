{
  "name": "awesome-claude-plugins-workspaces",
  "private": true,
  "engines": {
    "node": "24.22.2"
  },
  "workspaces": [
    "ui",
    "crawler",
    "shared/*"
  ],
  "scripts": {
    "build:ui": "bun run --filter awesome-claude-plugins build",
    "start:ui": "bun run --filter awesome-claude-plugins start",
    "build:crawler": "bun run --filter catalog-crawler build && bun run --filter catalog-crawler smoke:sqlite",
    "start:crawler": "bun run --filter catalog-crawler crawl",
    "test:snapshot": "bun run --filter @awesome-claude-plugins/catalog-snapshot test",
    "prepare:catalog": "bun run --filter awesome-claude-plugins prepare:catalog",
    "prepare": "cd .. && husky awesomeclaudeplugins.com/ui/.husky"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
