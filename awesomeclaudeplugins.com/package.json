{
  "name": "awesome-claude-plugins-workspaces",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.22.2"
  },
  "workspaces": [
    "ui",
    "crawler",
    "shared/*"
  ],
  "scripts": {
    "build:ui": "bun --filter awesome-claude-plugins build",
    "start:ui": "bun --filter awesome-claude-plugins start",
    "build:crawler": "bun --filter catalog-crawler build && bun --filter catalog-crawler smoke:sqlite",
    "start:crawler": "bun --filter catalog-crawler crawl"
  },
  "trustedDependencies": ["better-sqlite3"]
}
