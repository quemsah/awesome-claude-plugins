{
  "name": "awesome-claude-plugins-workspaces",
  "private": true,
  "engines": {
    "node": "24.22.2"
  },
  "workspaces": [
    "ui",
    "crawler",
    "shared/*"
  ],
  "scripts": {
    "build:ui": "npm run build --workspace=awesome-claude-plugins",
    "start:ui": "npm run start --workspace=awesome-claude-plugins",
    "build:crawler": "npm run build --workspace=catalog-crawler && npm run smoke:sqlite --workspace=catalog-crawler",
    "start:crawler": "npm run crawl --workspace=catalog-crawler"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
