{
  "name": "awesome-claude-plugins-workspaces",
  "private": true,
  "engines": {
    "node": "24.22.2"
  },
  "workspaces": [
    "ui",
    "crawler",
    "shared/*"
  ],
  "scripts": {
    "build:ui": "bun run --cwd ui build",
    "start:ui": "bun run --cwd ui start",
    "build:crawler": "bun run --cwd crawler build && bun run --cwd crawler smoke:sqlite",
    "start:crawler": "bun run --cwd crawler crawl"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
