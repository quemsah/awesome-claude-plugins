bun run --cwd awesomeclaudeplugins.com/ui lint || exit $?

# Do not require crawler dependencies for UI-only commits.
if git diff --cached --name-only -- awesomeclaudeplugins.com/crawler/ | grep -q .; then
  # Bun on Windows names its shims <cmd>.exe; npm and Bun on Unix use the bare name.
  biome=
  for dir in awesomeclaudeplugins.com/crawler/node_modules/.bin awesomeclaudeplugins.com/node_modules/.bin; do
    for shim in "$dir/biome" "$dir/biome.exe"; do
      [ -x "$shim" ] && biome=$shim
    done
  done
  if [ -z "$biome" ]; then
    echo 'Crawler dependencies are missing. Run: bun install --frozen-lockfile' >&2
    exit 1
  fi
  bun run --cwd awesomeclaudeplugins.com/crawler lint || exit $?
fi
