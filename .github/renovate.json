{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Athens",
  "separateMultipleMajor": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the Biome config schema URL together with the Biome version.",
      "managerFilePatterns": [
        "/^(ui|crawler)/biome\\.json$/"
      ],
      "matchStrings": ["\"\\$schema\": \"https://biomejs\\.dev/schemas/(?<currentValue>[0-9.]+)/schema\\.json\""],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Keep framework updates isolated for focused review.",
      "matchPackageNames": ["next", "react", "react-dom", "@next/bundle-analyzer"],
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["after 10am and before 11am on Monday"],
      "groupName": "framework dependency updates",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group lower-risk type and tooling updates.",
      "matchPackageNames": ["@biomejs/biome", "@playwright/test", "@tailwindcss/postcss", "husky", "tailwindcss", "typescript", "/^@types//"],
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["after 2pm and before 3pm on Wednesday"],
      "groupName": "tooling and type dependency updates",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group app runtime minor and patch updates apart from framework packages.",
      "matchPackageNames": [
        "@radix-ui/react-avatar",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-icons",
        "@radix-ui/react-select",
        "@radix-ui/react-slot",
        "class-variance-authority",
        "clsx",
        "fuse.js",
        "lucide-react",
        "next-themes",
        "recharts",
        "tailwind-merge",
        "use-debounce",
        "zod"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "schedule": ["after 4pm and before 5pm on Friday"],
      "groupName": "runtime dependency updates",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Keep every major dependency update in its own pull request.",
      "matchUpdateTypes": ["major"],
      "schedule": ["after 9am and before 10am on Tuesday"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
