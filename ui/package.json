    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "7.5.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
